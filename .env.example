# Required for the Base44 SDK to build a correct API path (e.g.
# /api/apps/<APP_ID>/functions/sendCareerApplication). Without it the SDK
# falls back to "null" and all backend function calls 404 on Vercel.
# Find the real value in Base44 Studio → your app → App ID.
VITE_BASE44_APP_ID=your_base44_app_id_here

# Optional Base44 SDK overrides — only set if you use them.
# VITE_BASE44_FUNCTIONS_VERSION=
# VITE_BASE44_APP_BASE_URL=